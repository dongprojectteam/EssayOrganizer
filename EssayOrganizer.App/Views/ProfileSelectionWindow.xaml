<ui:FluentWindow x:Class="EssayOrganizer.App.Views.ProfileSelectionWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="논술 정리 · 프로파일 선택"
                 Width="780"
                 Height="560"
                 MinWidth="660"
                 MinHeight="460"
                 WindowStartupLocation="CenterScreen"
                 ResizeMode="CanResize"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <!-- ListBoxItem Custom Style to eliminate ugly default Windows highlight -->
        <Style x:Key="ProfileItemContainerStyle" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="RootBorder"
                                Background="Transparent"
                                SnapsToDevicePixels="True"
                                Cursor="Hand">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Modern Fluent TitleBar -->
        <ui:TitleBar Grid.Row="0"
                     Title="논술 정리"
                     ShowMaximize="False"
                     ShowMinimize="True" />

        <!-- Header Section -->
        <StackPanel Grid.Row="1" Margin="0,16,0,20" HorizontalAlignment="Center">
            <Border Width="56" Height="56"
                    CornerRadius="28"
                    Background="{DynamicResource AccentTextFillColorPrimaryBrush}"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,14">
                <Border.Effect>
                    <DropShadowEffect Color="#4F46E5" BlurRadius="16" Opacity="0.3" ShadowDepth="4" />
                </Border.Effect>
                <ui:SymbolIcon Symbol="PersonCircle24" FontSize="30" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="누가 논술을 작성할까요?"
                       FontSize="24"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock Text="프로파일마다 작성한 논술과 서식이 개별적으로 안전하게 보관됩니다."
                       FontSize="13"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Margin="0,6,0,0"
                       HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Profiles List -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="30,0">
            <ListBox x:Name="ProfilesList"
                     BorderThickness="0"
                     Background="Transparent"
                     ItemContainerStyle="{StaticResource ProfileItemContainerStyle}"
                     SelectionChanged="ProfilesList_SelectionChanged"
                     MouseDoubleClick="ProfilesList_MouseDoubleClick">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Center" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <!-- Card Container -->
                            <Border x:Name="CardBorder"
                                    Width="150"
                                    Height="175"
                                    CornerRadius="16"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1.5"
                                    Padding="14">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="12" Opacity="0.08" ShadowDepth="3" />
                                </Border.Effect>

                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <!-- Avatar Area -->
                                    <Grid Width="78" Height="78">
                                        <!-- Gradient Colored Initial Avatar -->
                                        <Border CornerRadius="39"
                                                Background="{Binding AvatarBrush}">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#000000" BlurRadius="8" Opacity="0.15" ShadowDepth="2" />
                                            </Border.Effect>
                                            <TextBlock Text="{Binding Initial}"
                                                       FontSize="32"
                                                       FontWeight="Bold"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>

                                        <!-- Custom Photo (if set) with Rounded Corner Clip -->
                                        <Border CornerRadius="39">
                                            <Border.OpacityMask>
                                                <VisualBrush>
                                                    <VisualBrush.Visual>
                                                        <Border Width="78" Height="78" CornerRadius="39" Background="Black" />
                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </Border.OpacityMask>
                                            <Image Source="{Binding AvatarImage}" Stretch="UniformToFill" />
                                        </Border>
                                    </Grid>

                                    <!-- Profile Name -->
                                    <TextBlock Text="{Binding Name}"
                                               Margin="0,14,0,0"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               HorizontalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="120" />
                                </StackPanel>
                            </Border>

                            <!-- Selection Indicator Check Badge -->
                            <Border x:Name="SelectionBadge"
                                    Width="26"
                                    Height="26"
                                    CornerRadius="13"
                                    Background="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="0,6,6,0"
                                    Visibility="Collapsed">
                                <ui:SymbolIcon Symbol="Checkmark16" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>

                        <DataTemplate.Triggers>
                            <!-- Highlight and border change when item is selected -->
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                <Setter TargetName="CardBorder" Property="BorderThickness" Value="2" />
                                <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
                                <Setter TargetName="SelectionBadge" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource AccentFillColorSecondaryBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </ScrollViewer>

        <!-- Bottom Action Bar -->
        <Border Grid.Row="3"
                Padding="24,18"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Background="{DynamicResource ApplicationBackgroundBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <ui:Button Content="새 프로파일"
                               Icon="{ui:SymbolIcon Symbol=PersonAdd24}"
                               Appearance="Secondary"
                               Click="CreateProfile_Click"
                               Padding="16,9"
                               Margin="0,0,10,0" />
                    <ui:Button x:Name="EditButton"
                               Content="프로파일 수정"
                               Icon="{ui:SymbolIcon Symbol=Edit24}"
                               Appearance="Secondary"
                               Click="EditProfile_Click"
                               Padding="16,9"
                               IsEnabled="False" />
                </StackPanel>

                <ui:Button x:Name="SelectButton"
                           Grid.Column="2"
                           Content="선택하고 시작"
                           Icon="{ui:SymbolIcon Symbol=ArrowRight24}"
                           Appearance="Primary"
                           Click="SelectProfile_Click"
                           Padding="20,9"
                           IsEnabled="False" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
